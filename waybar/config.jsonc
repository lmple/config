{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "backlight",
    "network",
    "cpu",
    "custom/gpu",
    "memory",
    "temperature",
    "disk",
    "power-profiles-daemon",
    "battery",
    "custom/power"
  ],
  // ── Workspaces ──────────────────────────────────────────────────────────
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true
  },
  // ── Current window title ────────────────────────────────────────────────
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true
  },
  // ── Clock ───────────────────────────────────────────────────────────────
  "clock": {
    "format": " {:%a %d %b · %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  // ── System tray ─────────────────────────────────────────────────────────
  "tray": {
    "spacing": 8,
    "icon-size": 16
  },
  // ── Audio ───────────────────────────────────────────────────────────────
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 5
  },
  // ── Screen brightness: scroll to change it (through logind, no root) ────
  // Hidden on a machine without a backlight; no "device", so any panel works
  "backlight": {
    "format": "{icon} {percent}%",
    // Nerd Font glyphs (U+F00DE..U+F00E0 brightness 5/6/7)
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%",
    "scroll-step": 5,
    // So scrolling down can't turn the panel black
    "min-brightness": 5
  },
  // ── Network: click to connect (nmtui), right-click to edit saved ones ───
  "network": {
    // The icon follows the signal: empty, then one to four bars
    "format-wifi": "{icon} {essid} ({signalStrength}%)",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "⚠ disconnected",
    "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\nGateway: {gwaddr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    // nmtui-connect lists the networks in range and asks for a password
    // itself, so no nm-applet is needed to join one
    "on-click": "alacritty --title nmtui -e nmtui-connect",
    "on-click-right": "nm-connection-editor"
  },
  // ── CPU ──────────────────────────────────────────────────────────────────
  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": true,
    "interval": 2,
    "on-click": "alacritty --title btop -e btop"
  },
  // ── GPU: usage and VRAM of an NVIDIA or AMD card (gpu.sh) ───────────────
  // Hidden without one; a sleeping laptop dGPU shows as off, never woken
  "custom/gpu": {
    "exec": "~/.config/waybar/gpu.sh",
    "return-type": "json",
    "interval": 5
  },
  // ── Memory ───────────────────────────────────────────────────────────────
  "memory": {
    "format": "RAM {used:0.1f}/{total:0.1f}G",
    "tooltip-format": "Used: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
    "interval": 5
  },
  // ── Temperature ──────────────────────────────────────────────────────────
  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "tooltip": true
  },
  // ── Disk ─────────────────────────────────────────────────────────────────
  "disk": {
    "path": "/",
    "format": " {free}",
    "tooltip-format": "{path}: {used} used / {total} total ({percentage_used}%)",
    "interval": 30
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "ignored-power-supplies": [
        "ucsi-source-psy-USBC000:001",
        "ucsi-source-psy-USBC000:002",
        "ucsi-source-psy-USBC000:003"
    ],
    "states": {
        "good": 80,
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " full",
    "format-discharging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}\nPower draw: {power}W",
    "interval": 30
  },
  // ── Power profile (power-profiles-daemon): click cycles them ────────────
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    // Nerd Font glyphs (U+F0E7 bolt, U+F24E scale, U+F06C leaf)
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  // ── Power menu: lock, suspend, logout, reboot, shutdown ─────────────────
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power menu (Super+Escape)",
    "on-click": "~/.config/hypr/power-menu.sh"
  }
}
