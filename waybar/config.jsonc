{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "temperature",
    "disk",
    "battery"
  ],
  // ── Workspaces ──────────────────────────────────────────────────────────
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true
  },
  // ── Current window title ────────────────────────────────────────────────
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true
  },
  // ── Clock ───────────────────────────────────────────────────────────────
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%A %d %B %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  // ── System tray (nm-applet lives here) ──────────────────────────────────
  "tray": {
    "spacing": 8,
    "icon-size": 16
  },
  // ── Audio ───────────────────────────────────────────────────────────────
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 5
  },
  // ── Network (nm-applet handles connecting; this just shows status) ───────
  "network": {
    "format-wifi": " {essid} ({signalStrength}%)",
    "format-ethernet": " {ipaddr}",
    "format-disconnected": "⚠ disconnected",
    "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\nGateway: {gwaddr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "on-click": "nm-connection-editor"
  },
  // ── CPU ──────────────────────────────────────────────────────────────────
  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "interval": 2,
    "on-click": "kitty --title btop sh -c btop"
  },
  // ── Memory ───────────────────────────────────────────────────────────────
  "memory": {
    "format": " {used:0.1f}G",
    "tooltip-format": "Used: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
    "interval": 5
  },
  // ── Temperature ──────────────────────────────────────────────────────────
  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "tooltip": true
  },
  // ── Disk ─────────────────────────────────────────────────────────────────
  "disk": {
    "path": "/",
    "format": " {free}",
    "tooltip-format": "{path}: {used} used / {total} total ({percentage_used}%)",
    "interval": 30
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "ignored-power-supplies": [
        "ucsi-source-psy-USBC000:001",
        "ucsi-source-psy-USBC000:002",
        "ucsi-source-psy-USBC000:003"
    ],
    "states": {
        "good": 80,
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " full",
    "format-discharging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}\nPower draw: {power}W",
    "interval": 30
  }
}
