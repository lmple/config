# mako: notification popups for the Hyprland session (started by hyprland.lua).
# Catppuccin Mocha, with Waybar's font (waybar/style.css names the palette);
# the radius is hyprland.lua's rounding. The border is peach, not a red, so
# the critical one's red stands apart from it.

font=JetBrainsMono Nerd Font 11
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#fab387
border-size=2
border-radius=8
padding=10
width=360
anchor=top-right
margin=10
default-timeout=5000

# Critical ones stay until clicked: they are the ones that can't be missed
[urgency=critical]
border-color=#f38ba8
default-timeout=0

# Battery alerts (hypr/battery-notify.sh) go above fullscreen windows, which
# cover the default top layer; everything else stays hidden under a video
[app-name=battery]
layer=overlay
